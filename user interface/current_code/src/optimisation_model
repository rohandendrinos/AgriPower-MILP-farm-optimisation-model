######### extract sizing decisions ########
def get_sizing(variables):
    # number of panels by orientation
    panels = {}
    for d in orientations:
        panels[d] = variables["n_panels"][d].varValue
    # total solar capacity
    total_panels = 0
    for d in orientations:
        total_panels = total_panels + variables["n_panels"][d].varValue
    pv_capacity = panel_capacity * total_panels

    return {
        "S_b (battery size)": variables["S_b"].varValue,
        "S_inv_b (battery inverter size)": variables["S_inv_b"].varValue,
        "n_panels(no. panels by direction)": panels,
        "S_pv (total pv capacity)": pv_capacity,
    }


######### extract hourly energy flow and battery state #######
def get_dispatch(variables, times):
    flow_names = ["x_G_to_SN", "x_SN_to_G", "x_PV_to_SN", "x_SN_to_B", "x_B_to_SN", "x_M_to_SN", "E_B"]
    # iterate through each variable
    hourly_flows = {}
    for i in flow_names:
        # iterate through each time interval
        values = []
        for t in time_intervals:
            values.append(variables[i][t].varValue)
        hourly_flows[i] = values
    return pd.DataFrame(hourly_flows, index=times)
    


######## collect the front into a table ########
def summarise(results):
    # go through each solution in pareto results
    summary_rows = []
    for i in results:
        row = {}
        row["cost"] = i["cost"]
        row["emissions"] = i["emissions"]
        sizing = get_sizing(i["vars"])
        # add each pareto system size to the row
        for i in sizing:
            row[i] = sizing[i]
        summary_rows.append(row)
    return pd.DataFrame(summary_rows)


######## F6 outputs ###############
def plot_front(front, fname="pareto_front.png"):
    sorted_front = front.sort_values("emissions") # from lowest to highest emissions
    # create figure and plot
    fig, ax = plt.subplots(figsize=(7, 5))
    ax.plot(sorted_front["emissions"], sorted_front["cost"], "o-", color="tab:blue", zorder=2)
    # labels
    ax.set_xlabel("Emissions (kgCO$_2$e/day)")
    ax.set_ylabel("Cost ($/day)")
    ax.set_title("Pareto front: cost vs emissions")
    ax.grid(alpha=0.3, zorder=0)
    # label the two edge case points
    ax.annotate("min emissions", (sorted_front["emissions"].iloc[0], sorted_front["cost"].iloc[0]),
                textcoords="offset points", xytext=(8, 6))
    ax.annotate("min cost", (sorted_front["emissions"].iloc[-1], sorted_front["cost"].iloc[-1]),
                textcoords="offset points", xytext=(-8, 10), ha="right")
    # save
    fig.tight_layout()
    fig.savefig(fname, dpi=150)
    plt.show()

