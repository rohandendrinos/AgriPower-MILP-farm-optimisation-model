def max_panels(roof_area):
    """ the maximum number of solar panels that can fit on each 
        roof direction """
    if panel_area is None or roof_usable is None:
        return None
    result = {}
    for direction, area in roof_area.items():
        if area is None:
            return None
        result[direction] = math.floor(area * roof_usable / panel_area)
    return result

